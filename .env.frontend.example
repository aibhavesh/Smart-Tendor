# ---------------------------------------------------------------------------
# Tender Intelligence Platform — FRONTEND environment template.
# Copy to `frontend/.env.local`. NEXT_PUBLIC_* vars are inlined at build time.
#   Local dev:  cp .env.frontend.example frontend/.env.local
# ---------------------------------------------------------------------------

# Base URL of the Tender Intelligence API. Direct to the backend for `next dev`;
# under Docker Compose it is the nginx entrypoint, http://localhost:8080/api.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional Google sign-in. Email/password registration and login work without
# it. When set, use the same value as GOOGLE_CLIENT_ID in backend/.env because
# the backend verifies the token audience. See frontend/docs/google-sign-in.md.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional landing-page hero video. Defaults to the self-hosted
# /video/hero.mp4 when unset; override with a URL or another bundled path.
NEXT_PUBLIC_HERO_VIDEO=/video/hero.mp4

# --- Deploying the frontend (Netlify) -------------------------------------
# This one value is REQUIRED for a Netlify build. Set it under
# Site configuration > Environment variables > "Production build environment".
#
# Use the backend's BARE ORIGIN - scheme and host only, with NO trailing "/api":
#   NEXT_PUBLIC_API_BASE_URL=https://your-api.onrender.com
# The backend mounts routers under two prefixes ("/tenders/..." and
# "/api/v1/tenders/...") and the client appends both verbatim, so only the bare
# origin resolves both. The "/api" suffix is a Docker-Compose convention that
# nginx strips; pointing directly at the deployed API must not include it.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle by `next build`, so
# changing one requires a NEW BUILD. Republishing an existing deploy will not
# pick it up.

