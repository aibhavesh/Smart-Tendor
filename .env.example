# ---------------------------------------------------------------------------
# Tender Intelligence Platform — ROOT environment template.
#
# This file is read by Docker Compose alone, for the ${...} substitutions in
# docker-compose.yml. The applications read backend/.env and
# frontend/.env.local; this one only decides what Compose builds and starts.
#
# `./scripts/setup.ps1` (or setup.sh) creates and fills `.env` from this file.
# To do it by hand:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Postgres service ---
# Must agree with DATABASE_URL in backend/.env, which carries the same
# credentials in DSN form.
POSTGRES_USER=tender
POSTGRES_PASSWORD=tender
POSTGRES_DB=tender_intel

# --- Frontend build args ---
# NEXT_PUBLIC_* is inlined into the client bundle by `next build`, so Compose
# passes these as *build args* — setting them at runtime has no effect, the
# value is already baked into the image. Change one and you must rebuild:
#   docker compose up -d --build frontend
#
# The API base is the nginx entrypoint (:8080/api), not backend:8000 — the value
# is used by the browser, which cannot resolve a Compose service name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_HERO_VIDEO=/video/hero.mp4

# Optional Google sign-in. Email/password registration and login work without it.
# Use the same client ID as GOOGLE_CLIENT_ID in backend/.env — the backend
# verifies that the token's audience matches. See frontend/docs/google-sign-in.md.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
