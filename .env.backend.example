# ---------------------------------------------------------------------------
# Tender Intelligence Platform — BACKEND environment template.
# Copy to `backend/.env` and fill in. NEVER commit a real .env (see .gitignore).
#   Local dev:  cp .env.backend.example backend/.env
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=true

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated explicit allowlist. Must NOT be '*' in production (release gate).
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Database ---
# Local dev uses localhost. Inside Docker Compose, the DB host is the service
# name — set DATABASE_URL host to `postgres` (…@postgres:5432/…) for containers.
DATABASE_URL=postgresql+asyncpg://tender:tender@localhost:5432/tender_intel
DB_ECHO=false

# --- Auth ---
# Email/password is always available. Google sign-in is optional.
# Generate a strong value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be >=32 chars and not the default in production (release gate).
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Optional Google Identity Services client ID. The client secret is unused by
# the current ID-token flow and should normally remain blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Account admission ---
# Comma-separated list of organisation domains allowed to hold an account.
# Matching is exact — subdomains are NOT wildcarded. An empty value rejects
# every sign-in, and production refuses to start without one (release gate).
ALLOWED_EMAIL_DOMAINS=maheshwaricomputers.com
# Individually admitted addresses, for the occasional person who must have
# access without being on an organisation domain (a consultant, a contractor).
# Per ADDRESS, not per domain — listing a domain here would admit everyone who
# shares it. Comma-separated. Keep it short and review it.
ALLOWED_EMAIL_EXCEPTIONS=

# Email pre-provisioned as the first SUPER_ADMIN. The person may register with
# email/password or use Google; their account is born SUPER_ADMIN. Leave blank
# to skip the bootstrap. Never commit a real address.
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# --- Vector store / embeddings ---
QDRANT_URL=http://localhost:6333
# Required for Qdrant Cloud; leave blank for local Qdrant.
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./.qdrant
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
QDRANT_COLLECTION=past_projects

# --- AI Analyst (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Email notification (eligibility digest) ---
# Recipients are NEVER configured here. They are resolved from the user table
# at send time: every active user holding exactly the MANAGER role.
# Leave SMTP_HOST blank and nothing is sent; the digest reports why rather
# than silently succeeding.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=20
# The From address on the digest.
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_ENABLED=true

# --- Document pipeline ---
STORAGE_DIR=./.storage
DOWNLOAD_POLL_SECONDS=15
ENABLE_DOCUMENT_WORKER=true

# --- Extraction ---
EXTRACTION_TEXT_BACKEND=pdfplumber

# --- Decision inputs (optional until configured by an administrator) ---

# --- Observability ---
METRICS_ENABLED=true
METRICS_USER=metrics
# Generate a separate value for production. The production release gate rejects
# the default password and values shorter than 16 characters.
METRICS_PASSWORD=change-me-in-production
# Browser log ingestion (POST /observability/logs). Accepts anonymous callers by
# design — sign-in and landing-page errors happen before anyone holds a token —
# so the rate limit below is what keeps it from being an open write sink.
ENABLE_FRONTEND_LOGS=true
# Log entries accepted per minute, per signed-in user or per client address.
# Enforced per worker process, so the effective ceiling is workers x this value.
# The browser client's own steady maximum is 300/min. 0 disables the limit.
FRONTEND_LOG_ENTRIES_PER_MINUTE=600
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
LOG_LEVEL=INFO
JSON_LOGS=true

# Disable only on constrained/serverless deployments where a warm model and a
# long-running worker are not supported.
WARM_EMBEDDINGS_ON_STARTUP=true
