# Environment required by the document ingestion, extraction and eligibility workflow.
# Copy this file to backend/.env. Do not commit real credentials.

ENVIRONMENT=local
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080

# Use `postgres` as the host when running through Docker Compose.
DATABASE_URL=postgresql+asyncpg://tender:tender@localhost:5432/tender_intel

# Generate a strong value before production deployment.
JWT_SECRET=change-me-in-production

# Optional Google sign-in for the domain-restricted authentication flow.
GOOGLE_CLIENT_ID=

# Domain-restricted account admission and explicit individual exceptions.
ALLOWED_EMAIL_DOMAINS=gmail.com,example.com
ALLOWED_EMAIL_EXCEPTIONS=

# Past-project matching for eligibility.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# `fastembed` downloads BAAI/bge-small-en-v1.5 on first boot; `hash` is
# deterministic and fully offline, which is what constrained deployments want.
EMBEDDING_BACKEND=fastembed

# Tender document ingestion and PDF/Excel extraction.
STORAGE_DIR=./.storage
# Set false on serverless, where there is no long-running process to poll.
ENABLE_DOCUMENT_WORKER=true
EXTRACTION_TEXT_BACKEND=pdfplumber
WARM_EMBEDDINGS_ON_STARTUP=true

# Seeded as the first SUPER_ADMIN role assignment by migration d4a1e9c5b872.
# Set it BEFORE running `alembic upgrade head` on a new database — the migration
# runs once and is never re-applied, and it cannot be undone by downgrading,
# because the later revision f0e1d2c3b4a5 makes its downgrade raise. A database
# created without this value has no SUPER_ADMIN, and since only a SUPER_ADMIN can
# grant that role, nobody could ever administer it.
# Alternatively run `python scripts/manage.py bootstrap --email ...` from backend/.
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# GET /metrics, behind HTTP Basic with its own credentials. Keep this separate
# from JWT_SECRET; production rejects the template value when metrics are on.
METRICS_ENABLED=true
METRICS_USER=metrics
METRICS_PASSWORD=change-me-in-production

# Browser log ingestion. Anonymous by necessity — the errors worth capturing
# happen before anyone holds a token — so the per-entry rate limit is what keeps
# it from being an open write amplifier. 0 disables the limit (not advised).
ENABLE_FRONTEND_LOGS=true
FRONTEND_LOG_ENTRIES_PER_MINUTE=600
