# Environment required by the document ingestion, extraction and eligibility workflow.
# Copy this file to backend/.env. Do not commit real credentials.

ENVIRONMENT=local
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080

# Use `postgres` as the host when running through Docker Compose.
DATABASE_URL=postgresql+asyncpg://tender:tender@localhost:5432/tender_intel

# Generate a strong value before production deployment.
JWT_SECRET=change-me-in-production

# Optional Google sign-in for the domain-restricted authentication flow.
GOOGLE_CLIENT_ID=

# Domain-restricted account admission and explicit individual exceptions.
ALLOWED_EMAIL_DOMAINS=gmail.com,example.com
ALLOWED_EMAIL_EXCEPTIONS=

# Past-project matching for eligibility.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Tender document ingestion and PDF/Excel extraction.
STORAGE_DIR=./.storage
ENABLE_DOCUMENT_WORKER=true
EXTRACTION_TEXT_BACKEND=pdfplumber
WARM_EMBEDDINGS_ON_STARTUP=true
